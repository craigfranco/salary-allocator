{
  "name": "Scenario",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Scenario name"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about this scenario"
    },
    "department": {
      "type": "string",
      "enum": [
        "COMMERCIAL",
        "FINANCE",
        "HR",
        "ENGINEERING"
      ],
      "description": "Department this scenario belongs to",
      "default": "COMMERCIAL"
    },
    "snapshot": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Full employee snapshot at the time of save"
    }
  },
  "required": [
    "name",
    "snapshot"
  ]
}