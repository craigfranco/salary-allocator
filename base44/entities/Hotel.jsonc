{
  "name": "Hotel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Hotel display name"
    },
    "short_code": {
      "type": "string",
      "description": "Short identifier for the hotel"
    },
    "room_revenue_budget": {
      "type": "number",
      "description": "2027 Room Revenue Budget"
    },
    "sm_payroll_budget": {
      "type": "number",
      "description": "2027 S&M (Commercial) Payroll Budget"
    },
    "finance_payroll_budget": {
      "type": "number",
      "description": "2027 Finance Payroll Budget for this hotel",
      "default": 0
    },
    "hr_payroll_budget": {
      "type": "number",
      "description": "2027 HR Payroll Budget for this hotel",
      "default": 0
    },
    "engineering_payroll_budget": {
      "type": "number",
      "description": "2027 Engineering Payroll Budget for this hotel",
      "default": 0
    },
    "room_count": {
      "type": "number",
      "description": "Total number of guest rooms at the hotel"
    }
  },
  "required": [
    "name",
    "short_code"
  ]
}